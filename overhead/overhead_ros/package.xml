<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>overhead_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 adapters for the overhead camera vision and viewer system.</description>
  <maintainer email="overhead@example.com">Overhead Group</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>overhead_core</depend>
  <depend>multirobot_interfaces</depend>
  <depend>tsa_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
