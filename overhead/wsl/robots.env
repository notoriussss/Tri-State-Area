# Fast DDS environment configuration for the overhead PC inside WSL2 (mirrored networking).
# Sourced by overhead/wsl/wsl-entrypoint.sh; the collector robots do not need these settings.

# Shared ROS 2 domain across all Tri-State-Area groups.
export ROS_DOMAIN_ID=0

# Use eProsima Fast DDS so ROS_STATIC_PEERS unicast discovery is supported.
export RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Semicolon-separated static unicast peers for the collector robots (Phineas and Ferb).
# Ensures DDS discovery works even when campus Wi-Fi blocks multicast discovery.
export ROS_STATIC_PEERS="10.217.177.13;10.217.177.198"
