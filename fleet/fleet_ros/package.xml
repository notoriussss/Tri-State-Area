<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fleet_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 nodes and configuration for Phineas and Ferb collector robots.</description>
  <maintainer email="fleet@example.com">Fleet Group</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>fleet_core</depend>
  <depend>tsa_interfaces</depend>
  <depend>multirobot_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
